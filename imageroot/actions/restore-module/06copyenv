import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "ADMIN_EMAIL",
        "ADMIN_USERNAME",
        "ADMIN_ID",
        "ADMIN_PASSWORD_SET",
        "NOTIFICATION_EMAIL",
        "DEFAULT_LOCALE",
        "OIDC_ENABLED",
        "OIDC_DISCOVERY_URL",
        "OIDC_CLIENT_ID",
        "OIDC_SECRET_SET",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])
