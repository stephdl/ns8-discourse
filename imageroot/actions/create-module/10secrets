import os
import secrets

os.makedirs("secrets", mode=0o700, exist_ok=True)

db_password = secrets.token_urlsafe(32)

def write_secret(path, lines):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("\n".join(lines) + "\n")

write_secret("secrets/postgres.env", [
    f"POSTGRES_PASSWORD={secrets.token_urlsafe(32)}",
    f"DB_PASSWORD={db_password}",
])
write_secret("secrets/discourse.env", [
    f"DISCOURSE_DB_PASSWORD={db_password}",
    # Discourse accepts only 128 hex chars, otherwise it keeps a key in Redis that is not backed up
    f"DISCOURSE_SECRET_KEY_BASE={secrets.token_hex(64)}",
])
write_secret("secrets/oidc.env", [])
