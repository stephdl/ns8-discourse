import os
import sys
import json
import agent

rdb = agent.redis_connect(use_replica=True)
smarthost = agent.get_smarthost_settings(rdb)
route = agent.get_route(os.environ['MODULE_ID'])
host = os.getenv("TRAEFIK_HOST", "")

config = {
    "host": host,
    "lets_encrypt": route.get('lets_encrypt', False),
    "route_configured": bool(route),
    "admin_email": os.getenv("ADMIN_EMAIL", ""),
    "admin_username": os.getenv("ADMIN_USERNAME", ""),
    "admin_password_set": os.getenv("ADMIN_PASSWORD_SET") == "True",
    "notification_email": os.getenv("NOTIFICATION_EMAIL", ""),
    "default_locale": os.getenv("DEFAULT_LOCALE", "en"),
    "oidc_enabled": os.getenv("OIDC_ENABLED") == "True",
    "oidc_discovery_url": os.getenv("OIDC_DISCOVERY_URL", ""),
    "oidc_client_id": os.getenv("OIDC_CLIENT_ID", ""),
    "oidc_client_secret_set": os.getenv("OIDC_SECRET_SET") == "True",
    "oidc_callback_url": f"https://{host}/auth/oidc/callback" if host else "",
    "smarthost": {
        "enabled": smarthost["enabled"] and smarthost["host"] != "",
        "host": smarthost["host"],
    },
}

json.dump(config, fp=sys.stdout)
