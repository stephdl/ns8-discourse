{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get discourse settings",
    "$id": "http://nethserver.org/json-schema/task/output/discourse/get-configuration",
    "description": "Get discourse settings",
    "type": "object",
    "required": [
        "host",
        "lets_encrypt",
        "route_configured",
        "admin_email",
        "admin_username",
        "admin_password_set",
        "notification_email",
        "default_locale",
        "oidc_enabled",
        "oidc_discovery_url",
        "oidc_client_id",
        "oidc_client_secret_set",
        "oidc_callback_url",
        "smarthost"
    ],
    "properties": {
        "host": {"type": "string"},
        "lets_encrypt": {"type": "boolean"},
        "route_configured": {"type": "boolean"},
        "admin_email": {"type": "string"},
        "admin_username": {"type": "string"},
        "admin_password_set": {"type": "boolean"},
        "notification_email": {"type": "string"},
        "default_locale": {"type": "string"},
        "oidc_enabled": {"type": "boolean"},
        "oidc_discovery_url": {"type": "string"},
        "oidc_client_id": {"type": "string"},
        "oidc_client_secret_set": {"type": "boolean"},
        "oidc_callback_url": {"type": "string"},
        "smarthost": {
            "type": "object",
            "required": ["enabled", "host"],
            "properties": {
                "enabled": {"type": "boolean"},
                "host": {"type": "string"}
            }
        }
    }
}
