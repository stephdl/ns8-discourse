set -e -o pipefail
exec 1>&2

trap 'rm -rf restore' EXIT
mkdir -vp restore
mv -v discourse.pg_dump restore/

# The image bootstrap creates the discourse role and the extensions:
# restore everything else as that role
cat - >restore/zz_discourse_restore.sh <<'EOS'
pg_restore -l /restore/discourse.pg_dump | grep -v ' EXTENSION ' > /tmp/restore.list
pg_restore --no-owner --no-privileges -U postgres --role=discourse -d discourse -L /tmp/restore.list /restore/discourse.pg_dump
ec=$?
docker_temp_server_stop
exit $ec
EOS

podman run \
    --rm \
    --network=none \
    --volume=./restore:/restore:Z \
    --volume=./restore/zz_discourse_restore.sh:/docker-entrypoint-initdb.d/zz_discourse_restore.sh:Z \
    --volume=postgres-data:/var/lib/postgresql:Z \
    --env-file=secrets/postgres.env \
    --env TZ=UTC \
    --replace --name=restore_db \
    "${POSTGRES_IMAGE}"
