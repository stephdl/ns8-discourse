import os
import sys
import json
import agent

data = json.load(sys.stdin)

def write_secret(path, lines):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("".join(line + "\n" for line in lines))

# Applied and deleted by discourse-apply-admin once Discourse runs
if data.get("admin_password"):
    write_secret("secrets/admin_password", [data["admin_password"]])

if data.get("oidc_client_secret"):
    write_secret("secrets/oidc.env", ["DISCOURSE_OPENID_CONNECT_CLIENT_SECRET=" + data["oidc_client_secret"]])
    agent.set_env("OIDC_SECRET_SET", True)
